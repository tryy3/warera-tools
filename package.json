{
  "name": "warera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run dev:all",
    "dev:web": "vp dev",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:all": "concurrently -k \"pnpm dev:server\" \"pnpm dev:web\"",
    "build": "vp build && vp pack",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@libsql/client": "^0.17.4",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  }
}
