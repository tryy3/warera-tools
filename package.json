{
  "name": "warera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run dev:all",
    "dev:web": "vp dev",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:all": "concurrently -k \"pnpm dev:server\" \"pnpm dev:web\"",
    "build": "vp build && vp pack",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.0.12",
    "@libsql/client": "^0.17.4",
    "@sentry/node": "^10.69.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "0.14.0",
    "@tanstack/react-charts": "0.14.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "^10.0.1",
    "d3-scale": "^4.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tslog": "^5.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.23",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "catalog:",
